import { NextResponse } from "next/server";
import { serverSupabase } from "@/lib/supabase";

const db = () => serverSupabase();
const reply = (data, status = 200) => NextResponse.json(data, { status });

async function getUser(req) {
  const token = req.headers.get("authorization")?.replace(/^Bearer\s+/i, "");
  if (!token) return null;
  const { data, error } = await db().auth.getUser(token);
  return error ? null : data.user;
}

async function getProfile(id) {
  const { data } = await db().from("profiles").select("*").eq("id", id).single();
  return data;
}

async function isUnlocked(userId, surveyId) {
  const { data } = await db().from("unlocks").select("id")
    .eq("user_id", userId).or(`survey_id.is.null,survey_id.eq.${surveyId}`);
  return !!data?.length;
}

async function adminUser(req) {
  const user = await getUser(req);
  if (!user) return { error: reply({ error: "Please log in." }, 401) };
  const profile = await getProfile(user.id);
  if (profile?.role !== "admin") {
    return { error: reply({ error: "Admin access required." }, 403) };
  }
  return { user, profile };
}

export async function GET(req, context) {
  try {
    const { path = [] } = await context.params;
    const route = path.join("/");
    const user = await getUser(req);
    if (!user) return reply({ error: "Please log in first." }, 401);

    if (route === "me") {
      return reply({ user, profile: await getProfile(user.id) });
    }

    if (route === "surveys") {
      const { data, error } = await db().from("surveys")
        .select("id,title,description,created_at")
        .eq("active", true).order("created_at", { ascending: false });
      if (error) throw error;

      const { data: unlocks } = await db().from("unlocks")
        .select("survey_id").eq("user_id", user.id);
      const unlockedIds = new Set((unlocks || []).map(x => x.survey_id));
      const hasGlobalUnlock = unlockedIds.has(null);

      return reply({
        surveys: (data || []).map(s => ({
          ...s, unlocked: hasGlobalUnlock || unlockedIds.has(s.id)
        }))
      });
    }

    if (route.startsWith("surveys/")) {
      const id = route.split("/")[1];
      if (!(await isUnlocked(user.id, id))) {
        return reply({ error: "Your survey access is locked. Submit the KSh 100 payment first." }, 403);
      }
      const { data, error } = await db().from("surveys")
        .select("id,title,description,questions").eq("id", id).single();
      if (error) throw error;
      return reply({ survey: data });
    }

    if (route === "admin") {
      const admin = await adminUser(req);
      if (admin.error) return admin.error;

      const [users, payments, surveys] = await Promise.all([
        db().from("profiles").select("id,full_name,role,promo_balance,created_at"),
        db().from("payments").select("*").order("created_at", { ascending: false }),
        db().from("surveys").select("*").order("created_at", { ascending: false })
      ]);

      const rows = payments.data || [];
      for (const p of rows) {
        if (p.receipt_path) {
          const { data } = await db().storage.from("payment-receipts")
            .createSignedUrl(p.receipt_path, 3600);
          p.receipt_url = data?.signedUrl || null;
        }
      }

      return reply({
        users: users.data || [],
        payments: rows,
        surveys: surveys.data || []
      });
    }

    return reply({ error: "Not found." }, 404);
  } catch (e) {
    return reply({ error: e.message || "Server error." }, 500);
  }
}

export async function POST(req, context) {
  try {
    const { path = [] } = await context.params;
    const route = path.join("/");
    const user = await getUser(req);
    if (!user) return reply({ error: "Please log in first." }, 401);

    if (route === "payments/manual") {
      const form = await req.formData();
      const code = String(form.get("transactionCode") || "").trim().toUpperCase();
      const file = form.get("receipt");

      if (Number(form.get("amount")) !== 100) {
        return reply({ error: "The payment amount must be KSh 100." }, 400);
      }
      if (!/^[A-Z0-9]{8,15}$/.test(code)) {
        return reply({ error: "Enter a valid M-Pesa transaction code." }, 400);
      }
      if (!file || typeof file.arrayBuffer !== "function" || file.size > 5 * 1024 * 1024) {
        return reply({ error: "Choose a receipt image smaller than 5 MB." }, 400);
      }
      if (!["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
        return reply({ error: "Use a JPG, PNG or WebP image." }, 400);
      }

      const { data: duplicate } = await db().from("payments")
        .select("id").eq("transaction_code", code).maybeSingle();
      if (duplicate) return reply({ error: "That transaction code has already been submitted." }, 409);

      const extension = file.type === "image/png" ? "png" : file.type === "image/webp" ? "webp" : "jpg";
      const storagePath = `${user.id}/${Date.now()}-${code}.${extension}`;
      const bytes = Buffer.from(await file.arrayBuffer());

      const { error: uploadError } = await db().storage.from("payment-receipts")
        .upload(storagePath, bytes, { contentType: file.type });
      if (uploadError) throw uploadError;

      const { error } = await db().from("payments").insert({
        user_id: user.id,
        amount: 100,
        method: "pochi",
        transaction_code: code,
        receipt_path: storagePath,
        status: "pending"
      });
      if (error) throw error;

      return reply({ message: "Payment submitted. It is pending manual verification." });
    }

    if (route === "surveys/submit") {
      const body = await req.json();
      if (!body.surveyId || !body.answers || typeof body.answers !== "object") {
        return reply({ error: "Survey answers are required." }, 400);
      }
      if (!(await isUnlocked(user.id, body.surveyId))) {
        return reply({ error: "Survey access is locked." }, 403);
      }

      const { error } = await db().from("responses").insert({
        user_id: user.id,
        survey_id: body.surveyId,
        answers: body.answers
      });
      if (error) throw error;
      return reply({ message: "Your survey answers have been submitted." });
    }

    if (route === "admin/create-survey") {
      const admin = await adminUser(req);
      if (admin.error) return admin.error;
      const body = await req.json();
      const title = String(body.title || "").trim();
      const questions = body.questions;

      if (!title || !Array.isArray(questions) || !questions.length) {
        return reply({ error: "Add a title and at least one question." }, 400);
      }

      const { data, error } = await db().from("surveys").insert({
        title,
        description: String(body.description || ""),
        questions,
        created_by: admin.user.id,
        active: true
      }).select().single();
      if (error) throw error;
      return reply({ survey: data });
    }

    if (route === "admin/approve-payment") {
      const admin = await adminUser(req);
      if (admin.error) return admin.error;
      const body = await req.json();

      // This database function changes payment status and unlocks access atomically.
      const { error } = await db().rpc("approve_survey_payment", {
        p_payment_id: body.paymentId,
        p_admin_id: admin.user.id
      });
      if (error) throw error;
      return reply({ message: "Payment approved and survey access unlocked." });
    }

    if (route === "admin/reject-payment") {
      const admin = await adminUser(req);
      if (admin.error) return admin.error;
      const body = await req.json();

      const { data, error } = await db().from("payments").update({
        status: "rejected",
        verified_by: admin.user.id,
        verified_at: new Date().toISOString()
      }).eq("id", body.paymentId).in("status", ["pending", "review"]).select("id").maybeSingle();

      if (error) throw error;
      if (!data) return reply({ error: "Payment not found or already processed." }, 404);
      return reply({ message: "Payment rejected." });
    }

    return reply({ error: "Not found." }, 404);
  } catch (e) {
    return reply({ error: e.message || "Server error." }, 500);
  }
}
EOF

cat > app/page.js <<'EOF'
"use client";

import { useEffect, useState } from "react";
import { browserSupabase } from "@/lib/supabase";

const supabase = browserSupabase();
const PAY_NUMBER = "0718282275";
const BUSINESS = "Survey Kenya Ltd";

export default function Home() {
  const [session, setSession] = useState(null);
  const [profile, setProfile] = useState(null);
  const [surveys, setSurveys] = useState([]);
  const [mode, setMode] = useState("login");
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [fullName, setFullName] = useState("");
  const [code, setCode] = useState("");
  const [receipt, setReceipt] = useState(null);
  const [message, setMessage] = useState("");
  const [busy, setBusy] = useState(false);
  const [selected, setSelected] = useState(null);
  const [answers, setAnswers] = useState({});
  const [adminData, setAdminData] = useState(null);
  const [title, setTitle] = useState("");
  const [description, setDescription] = useState("");
  const [questions, setQuestions] = useState("");

  useEffect(() => {
    supabase.auth.getSession().then(({ data }) => setSession(data.session));
    const { data } = supabase.auth.onAuthStateChange((_event, s) => setSession(s));
    return () => data.subscription.unsubscribe();
  }, []);

  const token = session?.access_token;

  async function api(path, options = {}) {
    const headers = { ...(options.headers || {}), Authorization: `Bearer ${token}` };
    if (options.body && !(options.body instanceof FormData)) headers["Content-Type"] = "application/json";
    const res = await fetch(`/api/${path}`, { ...options, headers });
    const data = await res.json();
    if (!res.ok) throw new Error(data.error || "Request failed.");
    return data;
  }

  async function refresh() {
    if (!token) return;
    try {
      const [me, list] = await Promise.all([api("me"), api("surveys")]);
      setProfile(me.profile);
      setSurveys(list.surveys);
      if (me.profile?.role === "admin") setAdminData(await api("admin"));
    } catch (e) { setMessage(e.message); }
  }

  useEffect(() => { if (token) refresh(); }, [token]);

  async function auth(e) {
    e.preventDefault(); setBusy(true); setMessage("");
    try {
      if (mode === "register") {
        const { error } = await supabase.auth.signUp({
          email, password, options: { data: { full_name: fullName } }
        });
        if (error) throw error;
        setMessage("Registration submitted. Confirm your email if requested, then log in.");
        setMode("login");
      } else {
        const { error } = await supabase.auth.signInWithPassword({ email, password });
        if (error) throw error;
      }
    } catch (e) { setMessage(e.message); }
    finally { setBusy(false); }
  }

  async function pay(e) {
    e.preventDefault();
    if (!receipt) return setMessage("Choose your M-Pesa confirmation screenshot.");
    const form = new FormData();
    form.append("amount", "100");
    form.append("transactionCode", code);
    form.append("receipt", receipt);
    try {
      setBusy(true);
      const result = await api("payments/manual", { method: "POST", body: form });
      setMessage(result.message);
      setCode(""); setReceipt(null);
    } catch (e) { setMessage(e.message); }
    finally { setBusy(false); }
  }

  async function openSurvey(id) {
    try {
      const result = await api(`surveys/${id}`);
      setSelected(result.survey); setAnswers({});
    } catch (e) { setMessage(e.message); }
  }

  async function submitSurvey(e) {
    e.preventDefault();
    try {
      const result = await api("surveys/submit", {
        method: "POST",
        body: JSON.stringify({ surveyId: selected.id, answers })
      });
      setMessage(result.message); setSelected(null);
    } catch (e) { setMessage(e.message); }
  }

  async function adminAction(path, body) {
    try {
      const result = await api(path, { method: "POST", body: JSON.stringify(body) });
      setMessage(result.message || "Completed.");
      await refresh();
    } catch (e) { setMessage(e.message); }
  }

  async function createSurvey(e) {
    e.preventDefault();
    await adminAction("admin/create-survey", {
      title, description,
      questions: questions.split("\n").map(x => x.trim()).filter(Boolean)
    });
    setTitle(""); setDescription(""); setQuestions("");
  }

  if (!session) return <main className="auth"><section className="panel authpanel">
    <div className="logo">SK</div>
    <h1>Survey Kenya Ltd</h1>
    <p className="muted">Share your opinions. Participate in surveys.</p>
    <div className="tabs">
      <button className={mode === "login" ? "active" : ""} onClick={() => setMode("login")}>Login</button>
      <button className={mode === "register" ? "active" : ""} onClick={() => setMode("register")}>Register</button>
    </div>
    <form onSubmit={auth}>
      {mode === "register" && <label>Full name<input required value={fullName} onChange={e => setFullName(e.target.value)} /></label>}
      <label>Email<input type="email" required value={email} onChange={e => setEmail(e.target.value)} /></label>
      <label>Password<input type="password" minLength="6" required value={password} onChange={e => setPassword(e.target.value)} /></label>
      <button className="primary" disabled={busy}>{busy ? "Please wait..." : mode === "login" ? "Login" : "Create account"}</button>
    </form>
    {message && <p className="notice">{message}</p>}
  </section></main>;

  return <main className="page">
    <header className="topbar">
      <div><b>Survey Kenya Ltd</b><small>Member dashboard</small></div>
      <button className="secondary" onClick={() => supabase.auth.signOut()}>Logout</button>
    </header>

    {message && <div className="notice">{message}<button onClick={() => setMessage("")}>×</button></div>}

    <section className="welcome">
      <div><small className="eyebrow">MEMBER DASHBOARD</small><h1>Welcome{profile?.full_name ? `, ${profile.full_name}` : ""}</h1><p className="muted">Your account and available surveys.</p></div>
      <div className="credit"><small>Promotional credit</small><strong>KSh {Number(profile?.promo_balance || 0).toFixed(2)}</strong><small>Promotional value, not withdrawable cash.</small></div>
    </section>

    <section className="panel">
      <h2>Unlock survey access</h2>
      <p>Pay KSh 100 using Pochi la Biashara, then submit your transaction details for manual verification.</p>
      <div className="paymentbox">
        <span>Payment method</span><b>Pochi la Biashara</b>
        <span>Phone number</span><b className="number">{PAY_NUMBER}</b>
        <span>Business name</span><b>{BUSINESS}</b>
        <span>Amount</span><b>KSh 100</b>
      </div>
      <p className="small">Open M-Pesa → Lipa na M-Pesa → Pochi la Biashara. Enter the number above. Before confirming, check the recipient details shown by Safaricom. Only pay if they match the actual registered Pochi account.</p>
      <form onSubmit={pay}>
        <label>M-Pesa transaction code<input required value={code} onChange={e => setCode(e.target.value.toUpperCase())} placeholder="Enter transaction code" /></label>
        <label>Upload M-Pesa screenshot<input type="file" required accept="image/png,image/jpeg,image/webp" onChange={e => setReceipt(e.target.files?.[0] || null)} /></label>
        <button className="primary" disabled={busy}>{busy ? "Submitting..." : "Submit payment for verification"}</button>
      </form>
      <p className="small">Never upload your M-Pesa PIN, password or OTP. A screenshot is not proof by itself; payment is approved only after the transaction is checked against the actual account records.</p>
    </section>

    <section className="panel">
      <h2>Available surveys</h2>
      <div className="surveygrid">
        {surveys.map(s => <article className="survey" key={s.id}>
          <h3>{s.title}</h3><p>{s.description}</p>
          {s.unlocked ? <button className="primary" onClick={() => openSurvey(s.id)}>Open survey</button> : <span className="locked">Locked — payment required</span>}
        </article>)}
        {!surveys.length && <p className="muted">No surveys available yet.</p>}
      </div>
    </section>

    {selected && <section className="panel">
      <h2>{selected.title}</h2><p>{selected.description}</p>
      <form onSubmit={submitSurvey}>
        {selected.questions.map((q, i) => <label key={i}>{i + 1}. {q}<textarea required value={answers[i] || ""} onChange={e => setAnswers(a => ({ ...a, [i]: e.target.value }))} /></label>)}
        <button className="primary">Submit answers</button>
        <button type="button" className="secondary" onClick={() => setSelected(null)}>Close</button>
      </form>
    </section>}

    {profile?.role === "admin" && <section className="panel">
      <div className="adminhead"><h2>Admin dashboard</h2><button className="secondary" onClick={refresh}>Refresh</button></div>
      <h3>Create survey</h3>
      <form onSubmit={createSurvey}>
        <label>Title<input required value={title} onChange={e => setTitle(e.target.value)} /></label>
        <label>Description<input value={description} onChange={e => setDescription(e.target.value)} /></label>
        <label>Questions — one per line<textarea required value={questions} onChange={e => setQuestions(e.target.value)} /></label>
        <button className="primary">Create survey</button>
      </form>
      <h3>Payment submissions</h3>
      {(adminData?.payments || []).map(p => <article className="paymentrow" key={p.id}>
        <div><b>{p.transaction_code}</b><p>KSh {p.amount} · {p.status}</p>{p.receipt_url && <a href={p.receipt_url} target="_blank" rel="noreferrer">View screenshot</a>}</div>
        {["pending","review"].includes(p.status) && <div className="actions">
          <button className="primary" onClick={() => adminAction("admin/approve-payment", { paymentId: p.id })}>Approve</button>
          <button className="danger" onClick={() => adminAction("admin/reject-payment", { paymentId: p.id })}>Reject</button>
        </div>}
      </article>)}
      <h3>Members</h3>
      {(adminData?.users || []).map(u => <p className="member" key={u.id}>{u.full_name || "Member"} · {u.role} · Promo KSh {u.promo_balance}</p>)}
    </section>}

    <footer>© {new Date().getFullYear()} Survey Kenya Ltd</footer>
  </main>;
}
EOF

